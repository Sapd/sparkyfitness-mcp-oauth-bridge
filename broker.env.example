# ── Broker mode: for MCP clients that need Dynamic Client Registration (e.g. ChatGPT) ──
# The bridge acts as its own OAuth server towards the client (DCR + PKCE, public
# clients) and brokers the login to your IdP with ONE confidential client.
MODE=broker
PORT=8080

# Public URL of this bridge's MCP endpoint, and the issuer it advertises (its origin).
RESOURCE_URL=https://mcp-broker.example.com/mcp
OAUTH_ISSUER=https://mcp-broker.example.com

# ── Your OIDC identity provider ──────────────────────────────────────────────
ISSUER=https://idp.example.com/application/o/your-app/
USERINFO_URL=https://idp.example.com/application/o/userinfo/
UPSTREAM_AUTHORIZATION_ENDPOINT=https://idp.example.com/application/o/authorize/
UPSTREAM_TOKEN_ENDPOINT=https://idp.example.com/application/o/token/
UPSTREAM_CLIENT_ID=your-client-id
UPSTREAM_CLIENT_SECRET=your-client-secret
# Register this exact URL as a redirect URI at your IdP (default: <origin>/oauth/callback).
UPSTREAM_CALLBACK_URL=https://mcp-broker.example.com/oauth/callback

# ── Upstream SparkyFitness MCP server ─────────────────────────────────────────
UPSTREAM=http://sparkyfitness-mcp:3001

# ── SparkyFitness Postgres (owner/superuser role, see shim.env.example) ───────
PGHOST=sparkyfitness-db
PGPORT=5432
PGUSER=sparky
PGPASSWORD=changeme
PGDATABASE=sparkyfitness_db

# Key cache and broker state (registered clients, tokens). Protect this volume.
KEY_STORE=/data/keys.json
OAUTH_STORE=/data/oauth.json
KEY_NAME=mcp
# Max. dynamically registered clients (registration is unauthenticated).
MAX_CLIENTS=200
# SPARKYFITNESS_URL=https://fitness.example.com
