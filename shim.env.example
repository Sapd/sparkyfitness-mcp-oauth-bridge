# ── Bridge config ───────────────────────────────────────────────────────────
PORT=8080

# Public URL of THIS bridge's MCP endpoint (what you register in Claude).
RESOURCE_URL=https://mcp-oauth.example.com/mcp

# ── Your OIDC identity provider (ANY OIDC provider works, not just Authentik) ──
# ISSUER must match the `iss` of tokens / the discovery issuer.
# USERINFO_URL is the provider's OIDC userinfo endpoint — the bridge calls it to
# validate the access token and read the user's email. Works with opaque tokens.
ISSUER=https://idp.example.com/application/o/your-app/
USERINFO_URL=https://idp.example.com/application/o/userinfo/

# ── Upstream SparkyFitness MCP server ─────────────────────────────────────────
UPSTREAM=http://sparkyfitness-mcp:3001

# ── SparkyFitness Postgres ────────────────────────────────────────────────────
# IMPORTANT: api_key is under row-level security (owner_policy on app.user_id),
# so this role MUST bypass RLS — use the DB owner/superuser, not the app role.
PGHOST=sparkyfitness-db
PGPORT=5432
PGUSER=sparky
PGPASSWORD=changeme
PGDATABASE=sparkyfitness_db

# Where provisioned plaintext keys are cached (mount this on a protected volume).
KEY_STORE=/data/keys.json
